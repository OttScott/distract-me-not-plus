{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "{900f12d3-21f0-44b3-bc22-ee2d8e1a34ca}",
      "strict_min_version": "109.0"
    }
  },
  "name": "__MSG_appName__",
  "version": "3.15.1",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/magnet-16.png",
    "32": "icons/magnet-32.png",
    "48": "icons/magnet-48.png",
    "64": "icons/magnet-64.png",
    "128": "icons/magnet-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["index.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_icon": "icons/magnet-128.png",
    "default_popup": "index.html"
  },
  "options_ui": {
    "page": "index.html#settings",
    "open_in_tab": true
  },
  "background": {
    "scripts": ["service-worker.js"]
  },
  "author": "OttScott",
  "homepage_url": "https://github.com/OttScott/distract-me-not",
  "permissions": [
    "notifications",
    "activeTab",
    "storage",
    "tabs",
    "contextMenus",
    "webNavigation",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}